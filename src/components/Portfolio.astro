---
import { Image } from 'astro:assets'
import portrait from '../assets/daniel.jpg'
import shotDark from '../assets/task-manager-dark-es.png'
import shotLight from '../assets/task-manager-light.png'
import { LINKS, content, type Lang, type LineId } from '../i18n/content'
import Header from './Header.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = content[lang]
const heroLines: LineId[] = ['software', 'data', 'sales']
---

<Header lang={lang} />

<main id="main">
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero__map">
      <div class="incoming" aria-hidden="true">
        {
          heroLines.map((id) => (
            <span class={`route route--${id}`}>
              <span class="route__badge">{t.lines[id]}</span>
              <i class="route__stop" style="--at: 0.5" />
              <i class="route__stop" style="--at: 0.72" />
              <i class="route__stop" style="--at: 0.9" />
            </span>
          ))
        }
      </div>

      <svg class="bend" viewBox="0 0 72 136" aria-hidden="true">
        <path class="bend__path bend__path--software" d="M0 4H8L58 54H72" pathLength="1" />
        <path class="bend__path bend__path--data" d="M0 68H72" pathLength="1" />
        <path class="bend__path bend__path--sales" d="M0 132H8L58 82H72" pathLength="1" />
      </svg>

      <div class="station">
        <Image
          class="station__photo"
          src={portrait}
          alt={t.hero.photoAlt}
          widths={[200, 320, 480, 640]}
          sizes="(min-width: 1360px) 300px, (min-width: 821px) 22vw, 140px"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <h1 class="hero__name" id="hero-name">Daniel Pachón</h1>

      <div class="bundle bundle--hero" aria-hidden="true"></div>

      <p class="terminus">
        <span class="terminus__label">{t.hero.terminusLabel}</span>
        <span class="terminus__name">{t.hero.terminus}</span>
      </p>

      <div class="hero__meta">
        <p class="hero__role">{t.hero.role}</p>
        <p class="hero__pitch">{t.hero.pitch}</p>
        <div class="actions">
          <a class="button button--primary" href="#project">{t.hero.ctaProject}</a>
          <a class="button" href={LINKS.linkedin} rel="noopener" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10v7M7 7v.01M11 17v-4a2.5 2.5 0 0 1 5 0v4M11 10v7" /><rect x="3" y="3" width="18" height="18" rx="3" /></svg>
            {t.hero.ctaLinkedin}
          </a>
          <a class="button" href={LINKS.cv} download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
            {t.hero.ctaCv}
          </a>
        </div>
        <ul class="hero__legend" aria-hidden="true">
          {heroLines.map((id) => <li class={`pill pill--${id}`}>{t.lines[id]}</li>)}
        </ul>
        <ul class="hero__facts">
          {t.hero.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </div>
    <p class="visually-hidden">{t.hero.mapLabel}</p>
  </section>

  <section class="project" id="project" aria-labelledby="project-title">
    <div class="sign">
      <span class="pill pill--software">{t.lines.software}</span>
      <h2 class="sign__title" id="project-title">{t.project.heading}</h2>
    </div>
    <p class="project__tagline">{t.project.tagline}</p>

    <div class="project__body">
      <a class="shot" href={LINKS.taskManagerDemo} rel="noopener" target="_blank" aria-label={t.project.demo}>
        <Image class="shot__img shot__img--light" src={shotLight} alt={t.project.imageAltLight} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1100px) 760px, 100vw" />
        <Image class="shot__img shot__img--dark" src={shotDark} alt={t.project.imageAltDark} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1100px) 760px, 100vw" />
      </a>

      <div class="project__side">
        <div class="strip strip--software strip--compact">
          <ol class="strip__list">
          {
            t.project.facts.map((fact) => (
              <li class="stop">
                <span class="stop__dot" aria-hidden="true" />
                <span class="stop__title">{fact}</span>
              </li>
            ))
          }
          </ol>
        </div>
        <div class="actions">
          <a class="button button--primary" href={LINKS.taskManagerDemo} rel="noopener" target="_blank">
            {t.project.demo}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 16 8M9 8h7v7" /></svg>
          </a>
          <a class="button" href={LINKS.taskManagerWeb} rel="noopener" target="_blank">{t.project.codeWeb}</a>
          <a class="button" href={LINKS.taskManagerApi} rel="noopener" target="_blank">{t.project.codeApi}</a>
          <a class="button button--quiet" href={LINKS.taskManagerDocs} rel="noopener" target="_blank">{t.project.docs}</a>
        </div>
        <p class="note">{t.project.note}</p>
      </div>
    </div>
  </section>

  <section class="route-map" id="route" aria-labelledby="route-title">
    <div class="sign">
      <h2 class="sign__title" id="route-title">{t.route.heading}</h2>
    </div>
    <p class="section-intro">{t.route.intro}</p>

    <div class="network">
      {
        t.network.map((line) => (
          <section class={`line line--${line.id}`} aria-labelledby={`line-${line.id}`}>
            <h3 class="line__name" id={`line-${line.id}`}>
              <span class={`pill pill--${line.id}`}>{line.name}</span>
            </h3>
            <div class={`strip strip--${line.id}`}>
              <span class="strip__progress" aria-hidden="true" />
              <ol class="strip__list">
              {line.stations.map((station) => (
                <li class={`stop stop--${station.kind}`}>
                  <span class="stop__dot" aria-hidden="true" />
                  {station.kind === 'planned' ? (
                    <span class="stop__period">{t.route.planned}</span>
                  ) : (
                    <span class="stop__period">{station.period}</span>
                  )}
                  {station.detail ? (
                    <details class="stop__more">
                      <summary>
                        <span class="stop__title">{station.title}</span>
                        <svg class="stop__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4" /></svg>
                      </summary>
                      <p class="stop__detail">{station.detail}</p>
                    </details>
                  ) : (
                    <span class="stop__title">{station.title}</span>
                  )}
                  <span class="stop__org">{station.org}</span>
                </li>
              ))}
              </ol>
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <section class="stack" id="stack" aria-labelledby="stack-title">
    <div class="sign">
      <h2 class="sign__title" id="stack-title">{t.stack.heading}</h2>
    </div>
    <dl class="stack__lines">
      {
        t.stack.groups.map((group) => (
          <div class="stack__line">
            <dt>{group.name}</dt>
            <dd>
              <ul class="stops">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="contact__track" aria-hidden="true">
      <div class="bundle"></div>
      <span class="contact__buffer"></span>
    </div>
    <h2 class="contact__title" id="contact-title">{t.contact.heading}</h2>
    <p class="contact__body">{t.contact.body}</p>
    <div class="actions">
      <a class="button button--primary" href={LINKS.linkedin} rel="noopener" target="_blank">{t.contact.linkedin}</a>
      <a class="button" href={LINKS.cv} download>{t.contact.cv}</a>
      <a class="button button--quiet" href={LINKS.github} rel="noopener" target="_blank">{t.contact.github}</a>
    </div>
  </section>
</main>

<footer class="site-footer">
  <p>© 2026 Daniel Pachón. {t.footer.built}</p>
  <a href={LINKS.source} rel="noopener" target="_blank">{t.footer.source}</a>
</footer>

<script>
  import '../scripts/motion'
</script>
