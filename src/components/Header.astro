---
import { content, pathFor, type Lang } from '../i18n/content'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = content[lang].nav
const langs: { id: Lang; short: string; name: string }[] = [
  { id: 'en', short: 'EN', name: 'English' },
  { id: 'es', short: 'ES', name: 'Español' },
]
---

<a class="skip-link" href="#main">{t.skip}</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="monogram" href={pathFor(lang)} aria-label="Daniel Pachón">
      <span aria-hidden="true">DP</span>
    </a>
    <nav class="site-nav" aria-label={t.menu}>
      <a href="#project">{t.project}</a>
      <a href="#route">{t.route}</a>
      <a href="#stack">{t.stack}</a>
      <a href="#contact">{t.contact}</a>
    </nav>
    <div class="prefs">
      <div class="switch" role="group" aria-label={t.language}>
        {
          langs.map((l) => (
            <a
              class="switch__option"
              href={pathFor(l.id)}
              hreflang={l.id}
              lang={l.id}
              aria-current={l.id === lang ? 'true' : undefined}
              data-lang={l.id}
              title={l.name}
            >
              <span aria-hidden="true">{l.short}</span>
              <span class="visually-hidden">{l.name}</span>
            </a>
          ))
        }
      </div>
      <div class="switch" role="group" aria-label={t.theme}>
        <button class="switch__option" type="button" data-theme-option="light" aria-pressed="false" title={t.light}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <span class="visually-hidden">{t.light}</span>
        </button>
        <button class="switch__option" type="button" data-theme-option="dark" aria-pressed="false" title={t.dark}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <span class="visually-hidden">{t.dark}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement
  const options = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]')

  const sync = () =>
    options.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeOption === root.dataset.theme)))

  options.forEach((button) =>
    button.addEventListener('click', () => {
      root.dataset.theme = button.dataset.themeOption
      try {
        localStorage.setItem('dp.theme', button.dataset.themeOption!)
      } catch {}
      sync()
    }),
  )
  sync()

  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((link) =>
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('dp.lang', link.dataset.lang!)
      } catch {}
    }),
  )
</script>
